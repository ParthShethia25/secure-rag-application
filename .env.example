# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Backend selection: mock (default, deterministic, no dependencies)
#                    ollama (local Ollama server)
#                    openai (any OpenAI-compatible endpoint)
RAG_MODEL=mock

# --- openai backend -------------------------------------------------------
# Local FreeLLMAPI gateway (see docs/live-model-setup.md), or any provider
# that speaks the OpenAI /v1/chat/completions wire format.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=
LLM_MODEL=auto

# --- ollama backend -------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
